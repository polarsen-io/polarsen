# Copy this file to infra/.env and replace the <...> placeholders.
# bin/tests.sh generates random secrets when infra/.env is missing.

BOT_TOKEN=

# Postgres
# Password for the db container and the API. Required.
PG_PASSWORD=<set-a-strong-password>
# Optional. When set, the API uses this DSN instead of the PG_* variables.
# PG_DSN=postgres://postgres:<set-a-strong-password>@db:5432/polarsen

# AI providers
OPENAI_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# S3
# Shared by the API, the CLI listeners and the MinIO container. Required.
S3_ACCESS_KEY_ID=<set-an-access-key-id>
S3_SECRET_ACCESS_KEY=<set-a-secret-access-key>
S3_REGION=
S3_ENDPOINT=

API_URI=http://api:5050

CHAT_UPLOADS_S3_BUCKET=chat-uploads
